# Địa chỉ RPC của mạng Blockchain (mặc định: Hardhat Node local)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# API của IPFS node (Kubo / IPFS Desktop). Bỏ trống nếu không dùng IPFS.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
# Cổng Gateway để mở tệp theo CID
NEXT_PUBLIC_IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/
